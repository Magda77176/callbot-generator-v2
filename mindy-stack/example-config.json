{
  "app": {
    "name": "CallBot Tom",
    "version": "1.0.0",
    "environment": "production"
  },
  
  "vapi": {
    "apiKey": "${VAPI_API_KEY}",
    "assistant": {
      "name": "Tom",
      "firstMessage": "Bonjour! Je m'appelle Tom. Comment puis-je vous aider aujourd'hui?",
      "model": "gpt-4o-mini",
      "temperature": 0.3,
      "maxTokens": 150,
      "systemPrompt": "file://./system-prompt.txt"
    },
    "voice": {
      "provider": "google",
      "language": "fr-FR",
      "gender": "female",
      "speed": 1.0
    },
    "transcriber": {
      "provider": "google",
      "language": "fr-FR"
    },
    "serverUrl": "${WEBHOOK_URL}",
    "serverUrlSecret": "${WEBHOOK_SECRET}"
  },
  
  "openai": {
    "apiKey": "${OPENAI_API_KEY}",
    "model": "gpt-4o-mini",
    "temperature": 0.3
  },
  
  "services": [
    {
      "id": "consultation",
      "name": "Consultation générale",
      "price": 50,
      "currency": "EUR",
      "duration": 30,
      "description": "Examen dentaire complet et diagnostic"
    },
    {
      "id": "detartrage",
      "name": "Détartrage/Hygiène",
      "price": 80,
      "currency": "EUR",
      "duration": 45,
      "description": "Nettoyage professionnel des dents"
    },
    {
      "id": "carie",
      "name": "Traitement de carie",
      "price": 120,
      "currency": "EUR",
      "duration": 60,
      "description": "Remplissage de carie"
    },
    {
      "id": "extraction",
      "name": "Extraction dentaire",
      "price": 150,
      "currency": "EUR",
      "duration": 45,
      "description": "Extraction de dent définitive"
    },
    {
      "id": "couronne",
      "name": "Pose de couronne",
      "price": 400,
      "currency": "EUR",
      "duration": 90,
      "description": "Couronne dentaire en céramique"
    },
    {
      "id": "implant",
      "name": "Implant dentaire",
      "price": 800,
      "currency": "EUR",
      "duration": 120,
      "description": "Pose d'implant dentaire"
    },
    {
      "id": "blanchiment",
      "name": "Blanchiment dentaire",
      "price": 200,
      "currency": "EUR",
      "duration": 60,
      "description": "Blanchiment professionnel des dents"
    },
    {
      "id": "orthodontie",
      "name": "Orthodontie (bilan)",
      "price": 100,
      "currency": "EUR",
      "duration": 45,
      "description": "Bilan orthodontique et consultation"
    },
    {
      "id": "urgence",
      "name": "Urgence dentaire",
      "price": 75,
      "currency": "EUR",
      "duration": 30,
      "description": "Consultation d'urgence sans rendez-vous"
    }
  ],
  
  "conversation": {
    "maxDuration": 900,
    "steps": [
      "accueil",
      "triage",
      "besoin",
      "collecte",
      "confirmation"
    ],
    "requiredFields": [
      "firstName",
      "lastName",
      "phoneNumber"
    ],
    "emergencyKeywords": [
      "douleur extrême",
      "saigne",
      "cassé",
      "infection",
      "traumatisme",
      "accident"
    ],
    "emergencyAction": "transfer_samu_15"
  },
  
  "webhook": {
    "url": "${WEBHOOK_URL}",
    "secret": "${WEBHOOK_SECRET}",
    "timeout": 5000,
    "retries": 3,
    "retryDelay": 1000,
    "events": [
      "call.started",
      "call.completed",
      "call.failed",
      "emergency.detected",
      "appointment.booked"
    ]
  },
  
  "calendar": {
    "provider": "google_calendar",
    "integrations": [
      {
        "type": "google_calendar",
        "calendarId": "${GOOGLE_CALENDAR_ID}",
        "credentials": "${GOOGLE_CREDENTIALS}"
      },
      {
        "type": "outlook",
        "calendarId": "${OUTLOOK_CALENDAR_ID}",
        "credentials": "${OUTLOOK_CREDENTIALS}"
      }
    ],
    "autoSync": true,
    "timezone": "Europe/Paris"
  },
  
  "wordpress": {
    "pluginName": "callbot-tom",
    "version": "1.0.0",
    "wordpressMinVersion": "5.9",
    "phpMinVersion": "7.4",
    "apiEndpoint": "/wp-json/callbot-tom/v1",
    "widgetPosition": "bottom-right",
    "widgetButtonText": "Appeler Tom",
    "widgetButtonColor": "#2E7D32"
  },
  
  "security": {
    "apiKeyEncryption": true,
    "webhookSignature": "hmac-sha256",
    "corsAllowedOrigins": [
      "https://yourdomain.com",
      "https://www.yourdomain.com"
    ],
    "rateLimiting": {
      "enabled": true,
      "maxRequests": 100,
      "timeWindow": 60
    },
    "dataRetention": {
      "callRecordings": 90,
      "transcripts": 180,
      "customerData": 365
    }
  },
  
  "monitoring": {
    "sentryDsn": "${SENTRY_DSN}",
    "logLevel": "info",
    "metrics": {
      "trackCallDuration": true,
      "trackConversionRate": true,
      "trackAudioQuality": true,
      "trackResponseTime": true
    },
    "alerts": {
      "failureRate": 5,
      "responseTimeThreshold": 2000,
      "webhookFailureThreshold": 10
    }
  },
  
  "features": {
    "multiLanguage": false,
    "emergencyDetection": true,
    "appointmentSync": true,
    "callRecording": true,
    "transcription": true,
    "analyticsTracking": true,
    "abTesting": false
  },
  
  "database": {
    "type": "postgresql",
    "host": "${DB_HOST}",
    "port": 5432,
    "database": "${DB_NAME}",
    "user": "${DB_USER}",
    "password": "${DB_PASSWORD}",
    "ssl": true
  }
}
