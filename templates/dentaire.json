{
  "metadata": {
    "id": "dentaire",
    "name": "Cabinet Dentaire",
    "version": "1.0.0",
    "description": "Callbot pour cabinets dentaires - prise de RDV et triage urgences"
  },
  "bot": {
    "name": "Tom",
    "role": "Assistant vocal dentaire",
    "greeting": "Bonjour! Je m'appelle Tom, l'assistant vocal du cabinet dentaire. Comment puis-je vous aider aujourd'hui?",
    "tone": "professionnel et empathique",
    "voice": {
      "provider": "google",
      "language": "fr-FR",
      "gender": "female",
      "speed": 1.0
    }
  },
  "flow": {
    "steps": ["accueil", "triage", "besoin", "collecte", "confirmation"],
    "maxDuration": 900,
    "timeoutPerStep": [20, 30, 45, 60, 30]
  },
  "services": [
    {
      "id": "consultation",
      "name": "Consultation générale",
      "price": 50,
      "currency": "EUR",
      "duration": 30,
      "description": "Examen dentaire complet et diagnostic"
    },
    {
      "id": "detartrage",
      "name": "Détartrage/Hygiène",
      "price": 80,
      "currency": "EUR", 
      "duration": 45,
      "description": "Nettoyage professionnel des dents"
    },
    {
      "id": "carie",
      "name": "Traitement de carie",
      "price": 120,
      "currency": "EUR",
      "duration": 60,
      "description": "Remplissage de carie"
    },
    {
      "id": "urgence",
      "name": "Urgence dentaire",
      "price": 75,
      "currency": "EUR",
      "duration": 30,
      "description": "Consultation d'urgence sans rendez-vous"
    }
  ],
  "emergency": {
    "enabled": true,
    "keywords": ["douleur extrême", "saigne", "cassé", "infection", "traumatisme"],
    "action": "transfer_samu_15",
    "message": "Je transfère vers le SAMU (15). C'est une urgence."
  },
  "required_fields": [
    {
      "name": "firstName",
      "question": "Quel est votre prénom ?",
      "validation": "required"
    },
    {
      "name": "lastName", 
      "question": "Et votre nom de famille ?",
      "validation": "required"
    },
    {
      "name": "phoneNumber",
      "question": "Votre numéro de téléphone ?",
      "validation": "phone"
    },
    {
      "name": "appointmentDate",
      "question": "Quelle date vous conviendrait ?",
      "validation": "future_date"
    },
    {
      "name": "appointmentTime",
      "question": "Et quelle heure ?",
      "validation": "future_time"
    }
  ],
  "conversation": {
    "confirmation_template": "Récapitulons: {{firstName}} {{lastName}}, pour {{serviceName}}, le {{appointmentDate}} à {{appointmentTime}}, durée {{duration}} minutes, {{price}} euros. Votre téléphone: {{phoneNumber}}. Est-ce correct ?",
    "goodbye_message": "Merci ! À bientôt au cabinet."
  },
  "vapi": {
    "model": "gpt-4o-mini",
    "temperature": 0.3,
    "maxTokens": 150
  }
}